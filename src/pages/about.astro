---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---
<Layout title={`关于我 — ${profile.name} / ${profile.alias}`}>
  <section class="page-heading"><p class="eyebrow">ABOUT</p><h1>关于 {profile.name}</h1><p>{profile.role}</p></section>
  <div class="about-grid"><div class="prose">
    {profile.about.intro.map(paragraph=><p>{paragraph}</p>)}
    {profile.about.background.length > 0 && <section><h2>我的背景</h2>{profile.about.background.map(paragraph=><p>{paragraph}</p>)}</section>}
    <h2>关注的方向</h2>
    <dl class="focus-list">{profile.about.focus.map(item=><div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}</dl>
    <h2>联系我</h2><p>{profile.contact.intro}</p><div class="contact-links">{profile.contact.email && <a class="text-link" href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>}<a class="text-link" href={profile.github}>GitHub · @jackhe183 ↗</a></div>
  </div><aside class="about-portrait"><img src={profile.avatar} alt={profile.avatarAlt} width="300" height="300" /><p>{profile.name}<span> / {profile.alias}</span></p></aside></div>
</Layout>
