---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title="文章 — Jack He / Lemon"><section class="page-heading"><p class="eyebrow">WRITING</p><h1>文章与笔记</h1><p>关于 AI 评测、模型可靠性、LLM API 和工具构建的笔记。</p></section><section class="writing-list" aria-label="文章列表">{posts.length ? posts.map(post=><a class="post-row" href={`/writing/${post.id}/`}><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span>→</span></a>) : <div class="empty-writing"><h2>这里还没有公开文章。</h2><p>可以先从项目了解我的探索。文章发布后，会按时间排列在这里。</p><a class="text-link" href="/projects/">探索项目 →</a></div>}</section></Layout>
