---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const posts = await getCollection('writing', ({data})=>!data.draft); return posts.map(post=>({params:{id:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — Jack He`} description={post.data.description}><article class="article"><a class="text-link" href="/writing/">← 全部文章</a><header><p class="eyebrow">WRITING · <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time></p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p></header><div class="prose"><Content /></div></article></Layout>
