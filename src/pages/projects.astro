---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---
<Layout title="项目 — Jack He / Lemon">
  <section class="page-heading"><p class="eyebrow">PROJECTS</p><h1>项目与实践</h1><p>围绕 AI 评测、模型可靠性与开发者工具的公开项目。</p></section>
  <div class="project-details">{projects.map((project,index)=><article class="project-detail" id={project.name}>
    <div class="project-identity"><p class="eyebrow">0{index+1} / {project.category}</p><h2>{project.name}</h2><p class="project-note">{project.note}</p><div class="contact-links"><a class="text-link" href={project.url}>GitHub 仓库 ↗</a>{project.demo && <a class="text-link" href={project.demo}>体验项目 ↗</a>}</div></div>
    <div class="project-description"><h3>用途</h3><p>{project.purpose}</p><h3>提供什么</h3><ul>{project.capabilities.map(item=><li>{item}</li>)}</ul>{project.contribution && <section class="project-contribution"><h3>我负责的部分</h3><p>{project.contribution}</p></section>}{project.caveat && <p class="project-limit">{project.caveat}</p>}{project.upstream && <p class="project-limit">Fork 项目，上游来源：<a href={project.upstream}>{project.upstream.replace('https://github.com/','')} ↗</a>。</p>}</div>
  </article>)}</div>
  <p class="source-note">项目说明依据公开仓库 README 整理。具体功能、配置和使用方法请以仓库为准。</p>
</Layout>
